# Google OAuth web client. Enable the Google Drive API.
# Register APP_URL/api/auth/callback as the exact redirect URI.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
SESSION_SECRET=
# Only this verified Google email can create/manage the family workspace.
OWNER_EMAIL=
# Required on Vercel; use a TLS PostgreSQL URL.
DATABASE_URL=
# Separate ID for each deployment's family; do not reuse for previews.
WORKSPACE_ID=family
# Development only. Never enabled on Vercel or production.
ALLOW_LOCAL_PRIVATE=false
